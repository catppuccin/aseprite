---
whiskers:
  version: "^2.9.0"
  matrix:
    - flavor
  filename: "themes/{{ flavor.identifier }}/catppuccin-theme-{{ flavor.identifier }}/package.json"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
author:
  name: "Sofy"
  email: "contactsofycat@gmail.com"
---
{
  "name": "catppuccin-theme-{{ flavor.identifier }}",
  "displayName": "Catppuccin Theme {{ flavor.name }}",
  "description": "Soothing pastel theme for Aseprite",
  "version": "1.3",
  "author": { "name": "{{ author.name }}", "email": "{{ author.email }}", "url": "" },
  "contributors": [
  ],
  "publisher": "Catppuccin",
  "license": "MIT",
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      { "id": "Catppuccin Theme {{ flavor.name }}", "path": "." }
    ]
  }
}
